# Settings for the workshop registration page. Seat capacity lives in src/core/config.js.
# Start with a local .env copy; provide your own passwords and provider credentials there.
# Configure sending with docs/email-setup.md, or start in development with MAIL_MODE=log for local email previews.

APP_URL=http://localhost:3000 # The workshop site origin; keep this identical to the address attendees use.
HOST=127.0.0.1 # Next.js ignores HOST; use the --hostname option on npm start to change its bind address.
PORT=3000 # Listening port for the production server; development uses the framework config.
DB_PATH=.data/app.sqlite # Seat reservations and their confirmation messages; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Protect the operator who can review workshop registrations: username admin, random password of 16 or more characters.
MAIL_MODE=sandbox # Keep seat confirmations in sandbox while setting up; production sends email; log works locally in development.
MAIL_FROM=sender@example.com # Sender identity for seat confirmations; the domain must be verified in Mailtrap for production.
MAILTRAP_PRODUCTION_TOKEN= # Required for real seat confirmations: your Mailtrap transactional sending token. Not needed in sandbox.
MAILTRAP_SANDBOX_TOKEN= # API credential for the test inbox. Find it in that Mailtrap Sandbox inbox’s integration settings.
MAILTRAP_INBOX_ID= # Numeric Sandbox inbox ID where seat confirmations should appear; find it in the inbox integration settings.
